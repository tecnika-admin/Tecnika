<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <record id="hr_contract_view_form_nomina_cfdi" model="ir.ui.view">
        <field name="name">hr.contract.nomina</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
          <!--<field name="wage" position="attributes">
              <attribute name="readonly">"state != 'draft'"</attribute>
          </field>-->
          <xpath expr="//notebook" position="inside">
            <field name="company_cfdi" invisible="1"/>
            <page name="vacaciones" string="Días de vacaciones" invisible="company_cfdi != True">
                   <group>
                          <field name="tabla_vacaciones">
                            <list editable="bottom">
                                <field name="ano"/>
                                <field name="estado"/>
                                <!--<field name="dias_consumido" sum="Total"/>-->
                                <field name="dias" sum="Total Dias"/>
                                <field name="dias_otorgados" sum="Total"/>
                                <field name="caducidad"/>
                            </list>
                        </field>
                   </group>
                   <group>
                        <field name="vacaciones_adelantadas" readonly='1'/>
                   </group>
            </page>
            <page name='historial_salario' string="Historial salario" invisible="company_cfdi != True">
                 <field name="historial_salario_ids" readonly='1'>
                     <list string="Historial salario" editable="bottom">
                          <field name='fecha_sueldo'/>
                          <field name='sueldo_mensual'/>
                          <field name='sueldo_diario'/>
                          <field name='sueldo_por_hora'/>
                          <field name='sueldo_diario_integrado'/>
                          <field name='sueldo_base_cotizacion'/>
                     </list>
                 </field>
            </page>


          </xpath>
        </field>
    </record>

    <record id="action_dar_alta" model="ir.actions.server">
        <field name="name">Dar alta</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field name="model_id" ref="nomina_cfdi_ee.model_hr_contract"/>
        <field name="binding_model_id" ref="nomina_cfdi_ee.model_hr_contract"/>
        <field name="code">records.action_dar_alta()
        </field>
    </record>
</odoo>
